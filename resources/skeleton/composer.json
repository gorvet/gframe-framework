{
    "name": "gframe/project",
    "description": "Proyecto base para aplicaciones construidas con GFrame.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "gframe/framework": "^1.0"
    },
    "config": {
        "vendor-dir": "packages",
        "bin-dir": "packages/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "gframe:update": "@php packages/gframe/framework/bin/gframe-update"
    }
}
