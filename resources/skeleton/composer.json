{
    "name": "gframe/project",
    "description": "Proyecto base para aplicaciones construidas con GFrame.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1.9",
        "gorvet/gframe": "^2.0.1"
    },
    "config": {
        "vendor-dir": "packages",
        "bin-dir": "packages/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-autoload-dump": "@php packages/gorvet/gframe/bin/install-project-skills.php --project=.",
        "gframe:skills": "@php packages/gorvet/gframe/bin/install-project-skills.php --project=.",
        "gframe:update": "@php packages/gorvet/gframe/bin/gframe-update"
    }
}
