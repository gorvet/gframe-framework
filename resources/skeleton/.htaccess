Options -Indexes
<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^localhost(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_URI} ^/([^/]+)/? [NC]
    RewriteRule ^ - [E=PROJECT:%1]

    RewriteRule ^(?:app|bin|config|core|packages|storage)(?:/|$) - [F,NC]
    RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|README\.md)$ - [F,NC]
    RewriteRule (^|/)\. - [F,NC]
    RewriteRule ^(?!index\.php$|install\.php$).*\.(?:php[0-9]*|phtml|phar|sql|sqlite|sqlite3|log|bak)(?:/|$) - [F,NC]

    # Solo estas ubicaciones entregan archivos físicos directamente.
    RewriteRule ^(?:index|install)\.php$ - [END]
    RewriteRule ^public/ - [END]
    # Biblioteca pública estándar; no concede permisos sobre otras fuentes.
    RewriteRule ^uploads/(?:library|(?:user|tenant)/[1-9][0-9]*/library)/ - [END]
    RewriteRule ^(?:uploads|downloads|download)(?:/|$) - [F,NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [F]
    RewriteRule ^ index.php [END]

    <If "%{HTTP_HOST} =~ m#^localhost(?::[0-9]+)?$#">
        ErrorDocument 403 /%{ENV:PROJECT}/index.php
        ErrorDocument 404 /%{ENV:PROJECT}/index.php
        ErrorDocument 500 /%{ENV:PROJECT}/index.php
        ErrorDocument 503 /%{ENV:PROJECT}/index.php
    </If>
</IfModule>

ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
ErrorDocument 500 /index.php
ErrorDocument 503 /index.php
