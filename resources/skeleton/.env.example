APP_NAME="Mi aplicación"
APP_ENV="production"
APP_DEBUG="false"
APP_URL=""
APP_KEY=""

# real: cron del servidor; virtual: actividad HTTP de GFrame.
GFRAME_CRON_MODE="real"
GFRAME_CRON_MIN_INTERVAL="60"
GFRAME_CRON_BATCH_LIMIT="10"

DB_DRIVER="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# Antispam de formularios públicos que solicitan rate_limit; no limita el correo interno.
MAIL_RATE_LIMIT_ENABLED="true"
MAIL_RATE_LIMIT_MAX_ATTEMPTS="5"
MAIL_RATE_LIMIT_WINDOW_SECONDS="3600"

METRICOOL_HASH=""
