{
    "name": "gframe/framework",
    "description": "Framework PHP ligero para aplicaciones web, paneles administrativos y servicios HTTP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "mvc",
        "router",
        "orm"
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "hhxsv5/php-sse": "^2.0",
        "opis/closure": "^3.7",
        "phpmailer/phpmailer": "^6.12",
        "vlucas/phpdotenv": "^5.6",
        "wamania/php-stemmer": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "GFrame\\": "src/GFrame/"
        },
        "classmap": [
            "src/async/",
            "src/cron/",
            "src/database/",
            "src/error/",
            "src/heartbeat/",
            "src/middleware/",
            "src/render/",
            "src/routing/",
            "src/seo/",
            "src/services/",
            "src/utils/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "GFrame\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "test": "phpunit",
        "skills:check": "@php bin/validate-skills.php",
        "check": [
            "@lint",
            "@test",
            "@skills:check"
        ]
    },
    "config": {
        "vendor-dir": "packages",
        "bin-dir": "packages/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "support": {
        "issues": "https://github.com/gorvet/gframe-framework/issues",
        "source": "https://github.com/gorvet/gframe-framework"
    }
}
